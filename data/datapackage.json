      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "dialect": {
        "delimiter": ",",
        "header": true
      },
      "schema": {
        "fields": [
          {
            "name": "entry_no",
            "type": "string",
            "description": "假記番号。原文は漢数字表記",
            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "^2603-[0-9]{2}$"
            }
          },
          {
            "name": "entry_marker",
            "type": "string",
            "description": "原文の番号欄の先頭",
            "constraints": {
              "required": true,
              "enum": [
                "假記",
                "同"
              ]
            }
          },
          {
            "name": "rank_ja",
            "type": "string",
            "description": "階級",
            "constraints": {
              "required": true,
              "enum": [
                "海軍大尉",
                "海軍中尉"
              ]
            }
          },
          {
            "name": "rank_en",
            "type": "string",
            "description": "同じ階級の英語表記",
            "constraints": {
              "required": true,
              "enum": [
                "Lieutenant",
                "Sub-Lieutenant"
              ]
            }
          },
          {
            "name": "rank_source",
            "type": "string",
            "description": "階級が原文に書かれていたか、同から引き継いだか",
            "constraints": {
              "required": true,
              "enum": [
                "printed",
                "ditto"
              ]
            }
          },
          {
            "name": "name_as_printed",
            "type": "string",
            "description": "氏名。原文の字体のまま",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "surname",
            "type": "string",
            "description": "姓",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "given_name",
            "type": "string",
            "description": "名",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "subheading_ja",
            "type": "string",
            "description": "直前に置かれた小見出し。該当なしは空欄"
          },
          {
            "name": "order_class",
            "type": "string",
            "description": "叙勲の等級",
            "constraints": {
              "required": true,
              "enum": [
                "四等"
              ]
            }
          },
          {
            "name": "decoration",
            "type": "string",
            "description": "勲章",
            "constraints": {
              "required": true,
              "enum": [
                "瑞寶章"
              ]
            }
          }
        ],
        "primaryKey": "entry_no",
        "missingValues": [
          ""
        ]
      }
    },
    {
      "name": "investiture-json",
      "path": "investiture-1943-09-11.json",
      "format": "json",
      "mediatype": "application/json",
